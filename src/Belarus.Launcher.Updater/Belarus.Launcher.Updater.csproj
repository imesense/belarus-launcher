<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>

        <AssemblyName>SBLauncherUpdater</AssemblyName>
        <ApplicationIcon>..\Belarus.Launcher\Assets\Icons\stalker_cs.ico</ApplicationIcon>
        <UserSecretsId>604bcea0-0583-4597-9afc-fbf849a6fb90</UserSecretsId>
  </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Serilog.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Belarus.Launcher.Core\Belarus.Launcher.Core.csproj" />
    </ItemGroup>
</Project>
